<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingLeft="24dp"
    android:paddingTop="12dp"
    android:paddingRight="24dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/markerTimeLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Alert at" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/markerMinutes"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:hint="min"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLength="4" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:text=":"
            android:textSize="20sp" />

        <EditText
            android:id="@+id/markerSeconds"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:hint="sec"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLength="2" />
    </LinearLayout>

    <TextView
        android:id="@+id/markerTypeLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="When reached" />

    <RadioGroup
        android:id="@+id/markerTypeGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/typeVibrate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Vibrate" />

        <RadioButton
            android:id="@+id/typeBeep"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Beep" />
    </RadioGroup>

</LinearLayout>
