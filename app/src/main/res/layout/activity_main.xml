<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000"
    android:padding="20dp">

    <TextView
        android:id="@+id/timerText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="80dp"
        android:gravity="center"
        android:text="00:00:00"
        android:textColor="#666666"
        android:textSize="70sp"
        android:fontFamily="monospace"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/milliTimerText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="5dp"
        android:text="000"
        android:textColor="#666666"
        android:textSize="30sp"
        android:fontFamily="monospace"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/controlButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/startBtn"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:text="Start"
            android:textColor="#666666"
            android:background="@drawable/start_button_background"
            android:layout_margin="5dp"
            android:textSize="16sp" />

        <Button
            android:id="@+id/stopBtn"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:text="Stop"
            android:textColor="#666666"
            android:background="@drawable/button_background"
            android:layout_margin="5dp"
            android:textSize="16sp" />

        <Button
            android:id="@+id/resetBtn"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:text="Reset"
            android:textColor="#666666"
            android:background="@drawable/button_background"
            android:layout_margin="5dp"
            android:textSize="16sp" />

    </LinearLayout>

    <com.example.timerdnd.MarkerProgressBar
        android:id="@+id/markerBar"
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:layout_marginTop="30dp"
        android:contentDescription="Timer progress bar with alert points" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:text="Tap the bar to add an alert point.\nTap a point to edit or delete it."
            android:textColor="#666666"
            android:textSize="12sp" />

        <Button
            android:id="@+id/lengthBtn"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/button_background"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:text="Length 10:00"
            android:textColor="#666666"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="90dp"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="● Vibrate"
                android:textColor="#FFB300"
                android:textSize="12sp" />

            <SeekBar
                android:id="@+id/vibrateLevel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100"
                android:progressTint="#FFB300"
                android:thumbTint="#FFB300" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="90dp"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="● Beep"
                android:textColor="#26C6DA"
                android:textSize="12sp" />

            <SeekBar
                android:id="@+id/beepLevel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100"
                android:progressTint="#26C6DA"
                android:thumbTint="#26C6DA" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="90dp"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="♪ Tone"
                android:textColor="#26C6DA"
                android:textSize="12sp" />

            <Spinner
                android:id="@+id/toneSpinner"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/infoText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="24dp"
        android:text="Screen stays on while timer runs\nDark theme saves battery on OLED"
        android:textColor="#444444"
        android:textSize="12sp"
        android:gravity="center"
        android:fontFamily="monospace" />

</LinearLayout>